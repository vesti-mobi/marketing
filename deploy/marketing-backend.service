[Unit]
Description=Marketing Dashboard - backend Flask (API ao vivo /api/dados)
After=network.target

[Service]
User=allan
Group=allan
WorkingDirectory=/home/allan/marketing
EnvironmentFile=/home/allan/marketing/secrets/marketing.env
Environment=SNAPSHOT_PATH=/var/www/marketing/data/data.json
ExecStart=/home/allan/marketing/.venv/bin/gunicorn \
  --chdir /home/allan/marketing \
  --workers 1 --threads 4 --timeout 200 \
  --bind 127.0.0.1:5002 \
  backend.app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
